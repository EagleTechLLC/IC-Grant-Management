# =============================================================================
# Supabase
# =============================================================================
# Find these at: Supabase Dashboard → Settings → API
#
# NEXT_PUBLIC_ vars are safe to expose client-side.
# The anon key is designed to be public — RLS policies protect your data.
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key

# =============================================================================
# Sentry (add when configuring error tracking)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
